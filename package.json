{
  "name": "dsh-toolbox",
  "version": "0.1.0",
  "description": "工具箱 — a tabbed toolbox panel for DeepSeek Harness that embeds your local tools and dashboards.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "toolbox",
    "工具箱",
    "dashboard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BulidH/dsh-toolbox.git"
  },
  "homepage": "https://github.com/BulidH/dsh-toolbox#readme",
  "bugs": {
    "url": "https://github.com/BulidH/dsh-toolbox/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
